# Run with: python logos.py examples/foreign_cos_demo.lg --unsafe-ffi --allow-inferred-ffi-signatures
# Great Commission demo: calling a C math function via apocrypha.
# Windows: msvcrt.dll provides cos(double) -> double

apocrypha "msvcrt.dll" mystery cos();

mystery main() -> Void {
  inscribe x: HolyFloat = 0.0;
  inscribe y: HolyFloat = cos(x);
  proclaim y;
} amen
